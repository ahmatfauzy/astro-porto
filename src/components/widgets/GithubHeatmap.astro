---
import Icon from '../Icon.astro';
import { getGithubContributions, type GithubContributionDay } from '../../utils/github-contributions';

interface Props {
  username?: string;
}

const { username = 'ahmatfauzy' } = Astro.props;
const data = await getGithubContributions(username);

const heatmapDays = data?.days.slice(-26 * 7) ?? [];

const formatDate = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});

function getDayTitle(day: GithubContributionDay) {
  const label = day.count === 1 ? 'contribution' : 'contributions';

  return `${day.date}: ${day.count} ${label}`;
}

function getDayHref(day: GithubContributionDay) {
  if (day.count > 0) {
    return `https://github.com/${username}?from=${day.date}&to=${day.date}`;
  }

  return undefined;
}
---

{
  data && (
    <article class="glass-card heatmap-card">
      <div class="stats-row">
        <div class="stat-item">
          <strong>{data.total}</strong>
          <span>All-time contributions</span>
        </div>
        <div class="stat-item">
          <strong>{data.activeDays}</strong>
          <span>Active days</span>
        </div>
        <div class="stat-item">
          <strong>{data.currentStreak}</strong>
          <span>Day streak</span>
        </div>
      </div>

      {
        data.latest && (
          <aside class="latest-tip" aria-label="Latest activity">
            <div class="latest-list">
              <a
                class="latest-link"
                href={data.latest.href}
                aria-label={`Open latest activity: ${data.latest.repo}`}
              >
                <em>{data.latest.repo}</em>
                <time datetime={data.latest.date.toISOString()}>
                  {formatDate.format(data.latest.date)}
                </time>
                <span class="latest-icon" aria-hidden="true">
                  <Icon name="external" size={15} />
                </span>
              </a>
            </div>
          </aside>
        )
      }

      <div class="rhythm-grid" aria-label="Contribution activity in the last 26 weeks">
        <div class="heatmap-cells" style={`--week-count: ${Math.ceil(heatmapDays.length / 7)};`}>
          {
            heatmapDays.map((day) => {
              const href = getDayHref(day);
              const content = (
                <span
                  class={`heatmap-cell level-${day.level}`}
                  title={getDayTitle(day)}
                  aria-hidden="true"
                />
              );

              return href ? (
                <a class="cell-link" href={href} aria-label={getDayTitle(day)}>
                  {content}
                </a>
              ) : (
                <span class="cell-link static-cell" aria-label={getDayTitle(day)}>
                  {content}
                </span>
              );
            })
          }
        </div>
      </div>

      <footer>
        <span>Less</span>
        {[0, 1, 2, 3, 4].map((level) => <i class={`heatmap-cell level-${level}`} />)}
        <span>More</span>
      </footer>
    </article>
  )
}

<style>
  .heatmap-card {
    display: grid;
    gap: 16px;
    padding: 20px;
    border-color: transparent;
    background: transparent;
    box-shadow: none;
    overflow: visible;
    --heat-0: rgba(102, 125, 109, 0.16);
    --heat-1: #dce8dc;
    --heat-2: #b9cbb9;
    --heat-3: #8fa58f;
    --heat-4: #667d6d;
  }

  :root[data-theme='light'] .heatmap-card {
    --heat-0: rgba(46, 160, 67, 0.15);
    --heat-1: #9be9a8;
    --heat-2: #40c463;
    --heat-3: #30a14e;
    --heat-4: #216e39;
  }

  .heatmap-card:hover {
    border-color: transparent;
    box-shadow: none;
    transform: none;
  }

  .stats-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
  }

  .stat-item {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .stat-item strong {
    color: var(--paper-ink);
    font-size: 1.12rem;
    line-height: 1;
  }

  .stat-item span {
    overflow: hidden;
    color: var(--paper-ink-soft);
    font-size: 0.72rem;
    line-height: 1.2;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .latest-tip {
    display: grid;
    gap: 6px;
    padding: 10px 11px;
    border: 1px solid var(--paper-line);
    border-radius: 7px;
    background: var(--paper-surface-muted);
  }

  .latest-list {
    display: grid;
    gap: 4px;
  }

  .latest-link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) max-content 24px;
    align-items: center;
    min-width: 0;
    gap: 8px;
    color: inherit;
    text-decoration: none;
  }

  .latest-tip strong {
    color: var(--paper-accent);
    font-size: 0.7rem;
    line-height: 1.15;
  }

  .latest-tip em {
    overflow: hidden;
    color: var(--paper-ink);
    font-size: 0.8rem;
    font-style: normal;
    font-weight: 650;
    line-height: 1.2;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .latest-tip time {
    color: var(--paper-ink-soft);
    font-size: 0.68rem;
    line-height: 1;
    white-space: nowrap;
  }

  .latest-icon {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 8px;
    color: var(--paper-accent);
    transition:
      background 180ms ease,
      transform 180ms ease;
  }

  .latest-link:hover .latest-icon,
  .latest-link:focus-visible .latest-icon {
    background: var(--paper-control-hover);
    transform: translateY(-1px);
  }

  .latest-link:focus-visible {
    border-radius: 7px;
    outline: 2px solid color-mix(in srgb, var(--paper-accent) 28%, transparent);
    outline-offset: 3px;
  }

  .rhythm-grid {
    --cell-size: 8px;
    --cell-gap: 2.5px;
    display: grid;
    align-items: center;
    width: 100%;
    max-width: 100%;
    overflow: visible;
  }

  .heatmap-cells {
    display: grid;
    grid-auto-flow: column;
    grid-template-rows: repeat(7, var(--cell-size));
    grid-auto-columns: var(--cell-size);
    gap: var(--cell-gap);
    width: calc(
      (var(--cell-size) * var(--week-count)) + (var(--cell-gap) * (var(--week-count) - 1))
    );
    max-width: 100%;
  }

  .heatmap-cell,
  .cell-link {
    display: block;
    width: var(--cell-size);
    height: var(--cell-size);
    min-width: 8px;
    min-height: 8px;
  }

  .cell-link {
    position: relative;
    color: inherit;
    text-decoration: none;
  }

  .cell-link:hover .heatmap-cell {
    outline: 1px solid var(--paper-line-strong);
    outline-offset: 1px;
  }

  .heatmap-cell {
    border-radius: 2.5px;
    background: rgba(102, 125, 109, 0.12);
    box-shadow: inset 0 0 0 1px var(--paper-line);
  }

  .level-0 {
    background: var(--heat-0);
  }

  .level-1 {
    background: var(--heat-1);
  }

  .level-2 {
    background: var(--heat-2);
  }

  .level-3 {
    background: var(--heat-3);
  }

  .level-4 {
    background: var(--heat-4);
  }

  footer {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--paper-ink-faint);
    font-size: 0.72rem;
  }

  footer .heatmap-cell {
    --cell-size: 9px;
  }

  @media (max-width: 1180px) and (min-width: 821px) {
    .rhythm-grid {
      --cell-size: 8px;
    }
  }

  @media (max-width: 820px) {
    .heatmap-card {
      gap: 14px;
      padding: 0;
      overflow: hidden;
    }

    .rhythm-grid {
      --cell-gap: 2.5px;
      overflow: hidden;
      width: 100%;
    }

    .heatmap-cells {
      grid-template-rows: repeat(7, auto);
      grid-auto-columns: minmax(0, 1fr);
      width: 100%;
      max-width: 360px;
    }

    .heatmap-cells .heatmap-cell,
    .heatmap-cells .cell-link {
      width: 100%;
      height: auto;
      min-width: 0;
      min-height: 0;
      aspect-ratio: 1;
    }
  }
</style>