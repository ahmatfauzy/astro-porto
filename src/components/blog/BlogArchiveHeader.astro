---
interface Props {
  kicker?: string;
  title?: string;
  subtitle?: string;
  note?: string;
}

const { kicker, title, subtitle, note } = Astro.props;
const hasSubtitle = Boolean(subtitle?.trim());
const hasNote = Boolean(note?.trim());
const hasCopy = hasSubtitle || hasNote;
---

<header class="archive-hero archive-header-shared page-header-spacing">
  <div class="archive-header-main">
    <p class="archive-kicker">{kicker}</p>
    <h1 class="archive-title">{title}</h1>
  </div>
  {
    hasCopy && (
      <div class="archive-copy">
        {hasSubtitle && <p class="archive-subtitle">{subtitle}</p>}
        {hasNote && <p class="archive-note">{note}</p>}
      </div>
    )
  }
</header>
