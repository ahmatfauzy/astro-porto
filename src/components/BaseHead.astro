---
import type { ImageMetadata } from 'astro';
import ThemeBaseHead from '@navfolio/theme-default/components/BaseHead.astro';
import FallbackImage from '../assets/figure/fail-loading-image.png';
import { getSiteConfig } from '../data/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata | string;
}

const { title, description, image } = Astro.props;
const { site, fonts } = await getSiteConfig();
const escapedSiteName = site.title.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
const alreadyComposed =
  new RegExp(`^${escapedSiteName}\\s*\\|`).test(title) ||
  new RegExp(`\\|\\s*${escapedSiteName}\\s*$`).test(title);
const titleWithoutSiteName = title
  .replace(new RegExp(`\\s*[–—-]\\s*${escapedSiteName}\\s*$`), '')
  .trim();
const pageTitle = alreadyComposed ? title : `${titleWithoutSiteName || site.title} | ${site.title}`;
---

<ThemeBaseHead
  title={pageTitle}
  description={description}
  image={image}
  fallbackImage={FallbackImage}
  site={site}
  fonts={fonts}
/>
