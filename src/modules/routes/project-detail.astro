---
import { getCollection, render } from 'astro:content';
import { ExternalLink, Github } from 'lucide-astro';
import BlogArticle from '../../layouts/BlogArticle.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ id, data }) => id !== 'index' && !data.draft);

  return projects.map((project) => ({
    params: { slug: project.id },
    props: project,
  }));
}

const project = Astro.props;
const { Content, headings } = await render(project);
const projectLinks = project.data.links ?? [];
---

<BlogArticle
  post={project}
  headings={headings}
  sidebar={{ enable: false, ...project.data.sidebar }}
  heroSize="banner"
>
  {
    projectLinks.length > 0 && (
      <section class="project-links-preview" aria-label="Project links">
        {projectLinks.map((link) => {
          const isGithub = link.kind === 'github';
          return (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="project-preview-link"
            >
              <span class="preview-icon" aria-hidden="true">
                {isGithub ? <Github size={16} strokeWidth={1.8} /> : <ExternalLink size={16} strokeWidth={1.8} />}
              </span>
              <span class="preview-text">
                <strong>{link.label}</strong>
                <small>{link.href}</small>
              </span>
              <ExternalLink size={14} strokeWidth={1.8} aria-hidden="true" class="preview-arrow" />
            </a>
          );
        })}
      </section>
    )
  }
  <Content />
</BlogArticle>

<style>
  .project-links-preview {
    display: grid;
    gap: 8px;
    margin-bottom: 28px;
  }

  .project-preview-link {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    border: 1px solid var(--paper-line);
    border-radius: 8px;
    background: var(--paper-surface);
    color: inherit;
    text-decoration: none;
    transition:
      border-color 160ms ease,
      background 160ms ease,
      transform 160ms ease;
  }

  .project-preview-link:hover {
    border-color: var(--paper-line-strong);
    background: var(--paper-control-hover);
    transform: translateY(-1px);
  }

  .preview-icon {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    flex: 0 0 auto;
    border-radius: 7px;
    background: var(--paper-control);
    color: var(--paper-accent);
  }

  .preview-text {
    display: grid;
    gap: 2px;
    min-width: 0;
    flex: 1;
  }

  .preview-text strong {
    color: var(--paper-ink);
    font-family: var(--font-ui-label);
    font-size: 0.92rem;
    line-height: 1.2;
  }

  .preview-text small {
    overflow: hidden;
    color: var(--paper-ink-soft);
    font-family: var(--font-ui-label);
    font-size: 0.74rem;
    line-height: 1.3;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .preview-arrow {
    flex: 0 0 auto;
    color: var(--paper-ink-faint);
  }

  .project-preview-link:hover .preview-arrow {
    color: var(--paper-accent);
  }

  @media (max-width: 640px) {
    .preview-text small {
      white-space: normal;
      word-break: break-all;
    }
  }
</style>
